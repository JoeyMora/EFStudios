# Copy to .env and fill in what you have. Every key is optional;
# sources without a key are skipped.

# Spotify (discover artists by genre): https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 (emails in channel/video descriptions):
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Web search: set ONE of these.
# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=
# SerpAPI (Google results): https://serpapi.com/
SERPAPI_API_KEY=
