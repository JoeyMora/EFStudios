# Copy to .env and fill in what you have. Every key is optional;
# sources without a key are skipped. Restart the app after editing.

# Claude (smart prompt search, genre detection, "For you" suggestions):
# https://console.anthropic.com/  Without it, prompts use a simpler keyword parser.
ANTHROPIC_API_KEY=

# Instagram Business Discovery (official Meta API): bio, website and follower
# count of any business/creator account. See README for setup.
META_ACCESS_TOKEN=
IG_USER_ID=
# GRAPH_API_VERSION=v24.0

# Web search: set ONE. Also used to read Instagram/TikTok profile snippets.
# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=
# SerpAPI (Google results): https://serpapi.com/
SERPAPI_API_KEY=

# Spotify (discover by genre, follower counts): https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm (discover by tag or "similar to", listener counts): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# YouTube Data API v3 (emails in channel/video descriptions):
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
